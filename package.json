{
  "name": "dsh-edit-resend",
  "version": "0.2.0",
  "description": "Edit a sent user message in place and resend it, dropping everything after it — the Codex/Cursor edit-and-resend affordance, as a DSH user plugin.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "ylf",
  "keywords": ["dsh", "deepseek", "edit-and-resend", "cordis"],
  "repository": {
    "type": "git",
    "url": "https://github.com/<you>/dsh-edit-resend.git"
  },
  "bugs": {
    "url": "https://github.com/<you>/dsh-edit-resend/issues"
  },
  "homepage": "https://github.com/<you>/dsh-edit-resend#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "test": "node smoke.mjs",
    "test:real": "node realdeps.mjs",
    "test:browser": "node browser-test/cdp-test.mjs 9222"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "DOCS.md",
    "LICENSE",
    "smoke.mjs",
    "realdeps.mjs"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^1.13.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
